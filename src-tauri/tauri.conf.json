{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivloom",
  "version": "0.1.20",
  "identifier": "com.rivloom.desktop",
  "mainBinaryName": "Rivloom",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-main",
          "description": "Only the owned local application window can request native project selection and bootstrap info. Rust also checks its exact origin.",
          "windows": [
            "main"
          ],
          "local": false,
          "remote": {
            "urls": [
              "http://127.0.0.1:*"
            ]
          },
          "permissions": [
            "allow-desktop-info",
            "allow-inspect-lan-firewall",
            "allow-repair-lan-firewall",
            "allow-set-desktop-language",
            "allow-choose-project-directory",
            "allow-choose-task-file-destination",
            "allow-reveal-task-file",
            "allow-open-task-file",
            "allow-open-project-directory",
            "allow-notify-attention",
            "allow-play-completion-sound",
            "allow-take-notification-target",
            "allow-desktop-update-snapshot",
            "allow-check-desktop-update",
            "allow-skip-desktop-update",
            "allow-download-desktop-update",
            "allow-cancel-desktop-update",
            "allow-install-desktop-update",
            "allow-confirm-desktop-startup"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMUVDRjU1QTM5NEZGOUQKUldTZC81U2pWYzhlc2crVU9GZ2RiZkpycnZPZXJoZjhvNG9JSVZmWmZ6VzFCaWg1SFdGZ3dqK3YK",
      "endpoints": [
        "https://downloads.rivloom.com/updates/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "人与 AI 的任务协作桌面工作区",
    "resources": {
      "resources/runtime/": "runtime/",
      "icons/icon.ico": "brand/rivloom-206f0a8620fa.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
