{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivloom",
  "version": "0.1.0",
  "identifier": "com.rivloom.desktop",
  "mainBinaryName": "Rivloom",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [{
        "identifier": "desktop-main",
        "description": "Only the owned local application window can request native project selection and bootstrap info. Rust also checks its exact origin.",
        "windows": ["main"],
        "local": false,
        "remote": { "urls": ["http://127.0.0.1:*"] },
        "permissions": ["allow-desktop-info", "allow-choose-project-directory"]
      }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "人与 AI 的任务协作桌面工作区",
    "resources": { "resources/runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
